{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/view/**",
        "function": "bulletinOG"
      },
      {
        "source": "/church-sitemap.xml",
        "function": "churchSitemap"
      },
      {
        "source": "/bulletin-sitemap.xml",
        "function": "bulletinSitemap"
      },
      {
        "source": "/bulletin-rss.xml",
        "function": "bulletinSitemap"
      },
      {
        "source": "/website",
        "function": "siteOG"
      },
      {
        "source": "/searchable-churches.json",
        "function": "bulletinSitemap"
      },
      {
        "source": "/pricing",
        "destination": "/pricing.html"
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ]
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions"
    }
  ],
  "firestore": {
    "database": "(default)",
    "location": "asia-northeast3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
